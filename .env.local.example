# Descarga el JSON del service account (Firebase Console → Project settings →
# Service accounts → Generate new private key), y codifícalo en base64 en una
# sola línea, ej: node -e "console.log(Buffer.from(require('fs').readFileSync('service-account.json')).toString('base64'))"
# Un solo valor base64 evita que copiar/pegar en la UI de Vercel rompa los
# saltos de línea de la clave privada.
FIREBASE_SERVICE_ACCOUNT_BASE64=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Firebase Console → Project settings → General → Your apps → (agrega una Web app si no hay
# ninguna) → copia el "apiKey" del objeto firebaseConfig. Es público (se usa desde el navegador
# para el login), no es un secreto que proteger.
NEXT_PUBLIC_FIREBASE_API_KEY=
